{
  "name": "nexular-framework",
  "version": "0.1.0",
  "description": "SSR-first experimental framework inspired by Angular: modular architecture, signals-first, file-based routing, native MCP, i18n, security-first, selective island hydration",
  "author": "Nexular Framework Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexular/framework.git"
  },
  "bugs": {
    "url": "https://github.com/nexular/framework/issues"
  },
  "homepage": "https://github.com/nexular/framework#readme",
  "keywords": [
    "ssr",
    "server-side-rendering",
    "framework",
    "typescript",
    "signals",
    "reactive",
    "mcp",
    "file-based-routing",
    "island-hydration",
    "i18n",
    "security",
    "serverless"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "commonjs",
  "main": "dist/main.js",
  "bin": {
    "nexular": "dist/cli/index.js",
    "create-nexular": "dist/cli/create-nexular.js",
    "nexular-mcp": "dist/cli/mcp-stdio.js",
    "nexular-mcp-http": "dist/cli/mcp-http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "npx tsx scripts/build-client.ts",
    "build:client:watch": "npx tsx scripts/build-client.ts --watch",
    "dev:build": "tsc -p tsconfig.json --watch",
    "dev:serve": "node --watch dist/server/server.js",
    "dev:client": "npx tsx scripts/build-client.ts --watch",
    "dev": "concurrently -k -n BUILD,CLIENT,SSR \"npm:dev:build\" \"npm:dev:client\" \"npm:dev:serve\"",
    "create": "node dist/cli/create-nexular.js",
    "start": "node dist/server/server.js",
    "start:ssr": "node dist/server/server.js",
    "start:mcp:stdio": "node dist/cli/mcp-stdio.js",
    "start:mcp:http": "node dist/cli/mcp-http.js",
    "start:template:playground": "node dist/cli/index.js template playground",
    "test": "npm run test:all",
    "test:all": "npm run test:core && npm run test:showcase",
    "test:core": "vitest run -c vitest.core.config.ts",
    "test:core:coverage": "vitest run -c vitest.core.config.ts --coverage",
    "test:showcase": "vitest run -c vitest.showcase.config.ts --passWithNoTests",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "precommit": "npm run lint && npm run test",
    "ci": "npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.1.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "eslint": "^8.57.1",
    "prettier": "^3.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
